{
  "name": "margi-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MARGI AI — Vibe-Preserving Crowd Dispersion & Micro-MSME Rerouting Engine",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream -r --if-present run dev",
    "build": "pnpm --filter @margi-ai/shared build && pnpm --filter \"./apps/*\" --if-present run build",
    "lint": "eslint . && node scripts/lint-design.mjs && prettier --check .",
    "lint:design": "node scripts/lint-design.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "db:generate": "pnpm --filter api run db:generate",
    "db:migrate": "pnpm --filter api run db:migrate",
    "db:reset": "pnpm --filter api run db:reset",
    "db:seed": "pnpm --filter api run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@margi-ai/shared": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
