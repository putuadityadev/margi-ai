# ── App
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
APP_VERSION=0.1.0
GIT_COMMIT=dev

# ── Database / Cache / Storage
# Local dev defaults match `docker-compose.dev.yml` (127.0.0.1 bindings)
DATABASE_URL=postgresql://margi:margi_dev_only@127.0.0.1:5432/margi_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_UPLOADS=user-uploads
S3_BUCKET_PUBLIC=public-venues

# ── Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
ADMIN_EMAILS=
RESEND_API_KEY=
MAIL_FROM="MARGI AI <no-reply@margiai.id>"

# ── AI (OpenRouter)
OPENROUTER_API_KEY=
LLM_VISION_MODEL=google/gemini-2.5-flash
LLM_AGENT_MODEL=google/gemini-2.5-flash
LLM_FALLBACK_MODELS=openai/gpt-4o-mini,anthropic/claude-haiku-4.5
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MOCK=false
COS_FLOOR=0.20
COS_CEIL=0.85

# ── Telemetry
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=
SIM_SURGE_PERCENT=115

# ── Observability (optional)
SENTRY_DSN=
METRICS_BASIC_AUTH=

# ── Web (build-time, Vite)
VITE_APP_URL=http://localhost:5173
VITE_API_BASE=/api/v1
# Optional raster tile template for the explore map; empty uses public OpenStreetMap tiles.
VITE_MAP_TILE_URL=

