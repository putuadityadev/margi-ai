{
  "name": "@margi-ai/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants.d.ts",
        "default": "./dist/constants.js"
      },
      "require": {
        "types": "./dist/constants.d.cts",
        "default": "./dist/constants.cjs"
      }
    },
    "./time": {
      "import": {
        "types": "./dist/time.d.ts",
        "default": "./dist/time.js"
      },
      "require": {
        "types": "./dist/time.d.cts",
        "default": "./dist/time.cjs"
      }
    },
    "./scoring": {
      "import": {
        "types": "./dist/scoring.d.ts",
        "default": "./dist/scoring.js"
      },
      "require": {
        "types": "./dist/scoring.d.cts",
        "default": "./dist/scoring.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      },
      "require": {
        "types": "./dist/schemas.d.cts",
        "default": "./dist/schemas.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --no-clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "tsup": "^9.0.0"
  },
  "typesVersions": {
    "*": {
      "constants": [
        "./dist/constants.d.ts"
      ],
      "time": [
        "./dist/time.d.ts"
      ],
      "scoring": [
        "./dist/scoring.d.ts"
      ],
      "schemas": [
        "./dist/schemas.d.ts"
      ],
      "engine": [
        "./dist/engine.d.ts"
      ]
    }
  }
}
