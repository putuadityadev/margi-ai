# Copy to ../.env.production on the server and fill in. Never commit the real file.

# Public address (Caddy gets a certificate for DOMAIN automatically).
DOMAIN=margi.example.com
APP_URL=https://margi.example.com

# Database (the compose file builds DATABASE_URL from these).
POSTGRES_USER=margi
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=margi

# Sessions and admin. ADMIN_EMAILS (comma separated) become curators on sign-up or login.
JWT_ACCESS_SECRET=change-me-long-random
ADMIN_EMAILS=you@example.com

# AI (OpenRouter) and routing (TomTom). Without OPENROUTER_API_KEY the Copilot and chat answer 503.
OPENROUTER_API_KEY=
LLM_AGENT_MODEL=deepseek/deepseek-v4.1-flash
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MOCK=false
TOMTOM_API_KEY=

# Google sign-in (optional; leave all three empty to hide the button).
# Authorised redirect URI in Google Cloud: https://DOMAIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://margi.example.com/api/v1/auth/google/callback

HTTP_USER_AGENT=MARGI AI (https://margi.example.com)
